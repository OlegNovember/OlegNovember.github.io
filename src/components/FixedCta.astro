<style>
    .cta-fixed {
        position: fixed;
        bottom: 24px; right: 24px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 24px;
        background: linear-gradient(135deg, #3b82f6, #8b5cf6);
        color: #fff;
        text-decoration: none;
        border-radius: 50px;
        font-size: 14px;
        font-weight: 600;
        box-shadow: 0 12px 32px rgba(59,130,246,0.4);
        z-index: 98;
        opacity: 0;
        transform: translateY(30px);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cta-fixed.show {
        opacity: 1;
        transform: translateY(0);
    }
    .cta-fixed:hover {
        transform: translateY(-3px);
        box-shadow: 0 16px 40px rgba(59,130,246,0.6);
    }
    @media (max-width: 640px) {
        .cta-fixed span { display: none; }
        .cta-fixed { padding: 16px; border-radius: 50%; }
    }
</style>

<script>
    const cta = document.getElementById('ctaFixed');
    window.addEventListener('scroll', () => {
        if (window.scrollY > 800) cta?.classList.add('show');
        else cta?.classList.remove('show');
    }, { passive: true });
</script>