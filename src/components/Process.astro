---
const steps = [
    { num: '01', title: 'Заявка', text: 'Ты пишешь в Telegram или оставляешь заявку на сайте. Отвечаю в течение часа.' },
    { num: '02', title: 'Бриф', text: 'Обсуждаем задачу: для кого сайт, какие блоки, какой стиль. Присылаю примеры.' },
    { num: '03', title: 'Вёрстка', text: 'Делаю сайт за 1–3 дня. Показываю промежуточный результат, вношу правки.' },
    { num: '04', title: 'Сдача', text: 'Заливаю на хостинг, подключаю домен, настраиваю SSL. Передаю доступы.' }
];
---

<section class="section">
    <div class="container">
        <div class="section-label reveal">Процесс</div>
        <h2 class="section-title reveal d-1">Как мы <em>работаем</em></h2>
        <p class="section-sub reveal d-2">Четыре шага от заявки до готового сайта</p>

        <div class="process-grid">
            {steps.map((s, i) => (
                <div class={`process-item reveal d-${i + 1}`}>
                    <div class="process-num">{s.num}</div>
                    <h4>{s.title}</h4>
                    <p>{s.text}</p>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .process-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 24px;
        margin-top: 60px;
    }
    .process-item {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 20px;
        padding: 32px 28px;
        transition: all 0.4s;
    }
    .process-item:hover {
        border-color: rgba(59,130,246,0.4);
        transform: translateY(-6px);
    }
    .process-num {
        font-family: 'JetBrains Mono', monospace;
        font-size: 14px;
        color: #3b82f6;
        font-weight: 700;
        letter-spacing: 2px;
        margin-bottom: 20px;
    }
    .process-item h4 {
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 12px;
    }
    .process-item p {
        color: #8a9aa8;
        font-size: 14px;
        line-height: 1.7;
    }
    @media (max-width: 1024px) {
        .process-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 640px) {
        .process-grid { grid-template-columns: 1fr; }
    }
</style>