<script>
    const heroTitle = document.getElementById('heroTitle');
    if (heroTitle) {
        const finalText = heroTitle.dataset.scramble || '';
        const chars = '!<>-_\\/[]{}—=+*^?#________';
        let iteration = 0;
        function scramble() {
            const scrambled = finalText.split('').map((char, index) => {
                if (index < iteration) return finalText[index];
                if (char === ' ') return ' ';
                return chars[Math.floor(Math.random() * chars.length)];
            }).join('');
            heroTitle.textContent = scrambled;
            if (iteration >= finalText.length) return;
            iteration += 1 / 3;
            requestAnimationFrame(scramble);
        }
        setTimeout(scramble, 600);
    }

    const heroAvatar = document.getElementById('heroAvatar');
    if (heroAvatar && window.matchMedia('(min-width: 1025px)').matches) {
        window.addEventListener('scroll', () => {
            const scrollY = window.scrollY;
            if (scrollY < 900) {
                heroAvatar.style.transform = `translateY(${scrollY * 0.06}px)`;
            }
        }, { passive: true });
    }
</script>