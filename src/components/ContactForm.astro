---
---

<section id="form" class="section section-dark">
    <div class="container">
        <div class="form-wrap reveal-scale">
            <div class="form-info">
                <div class="section-label">Связаться</div>
                <h3>Заказать <em>лендинг</em></h3>
                <p>Напиши пару слов о задаче. Отвечу в течение часа и предложу решение.</p>
                <ul class="form-benefits">
                    <li>Ответ в течение часа</li>
                    <li>Бесплатная консультация</li>
                    <li>Смета в день обращения</li>
                    <li>Без обязательств</li>
                </ul>
            </div>
            <form class="form" id="contactForm" novalidate>
                <div class="form-group">
                    <label for="name">Имя</label>
                    <input type="text" id="name" name="name" placeholder="Как к тебе обращаться?" required />
                </div>
                <div class="form-group">
                    <label for="contact">Telegram или телефон</label>
                    <input type="text" id="contact" name="contact" placeholder="@username или +7..." required />
                </div>
                <div class="form-group">
                    <label for="service">Что нужно?</label>
                    <select id="service" name="service" required>
                        <option value="">Выбери формат</option>
                        <option value="Визитка — 5 000 ₽">Визитка — 5 000 ₽</option>
                        <option value="Лендинг — 9 000 ₽">Лендинг — 9 000 ₽</option>
                        <option value="Лендинг + реклама — 20 000 ₽">Лендинг + реклама — 20 000 ₽</option>
                        <option value="Другое">Другое</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="message">Комментарий</label>
                    <textarea id="message" name="message" rows="3" placeholder="Коротко о задаче..."></textarea>
                </div>
                <div class="checkbox-group">
                    <input type="checkbox" id="consent" name="consent" required />
                    <label for="consent">
                        Я согласен на обработку персональных данных и принимаю 
                        <a href="/privacy" target="_blank">политику конфиденциальности</a>
                    </label>
                </div>
                <button type="submit" class="btn btn-primary btn-full">
                    <span>Отправить заявку</span>
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
            </form>
        </div>
    </div>
</section>

<style>
    .form-wrap {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 80px;
        align-items: start;
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 24px;
        padding: 60px;
    }
    .form-info h3 {
        font-size: 42px;
        font-weight: 900;
        line-height: 1.1;
        letter-spacing: -1px;
        margin-bottom: 20px;
    }
    .form-info h3 em {
        font-style: normal;
        background: linear-gradient(135deg, #3b82f6, #8b5cf6);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .form-info > p {
        color: #8a9aa8;
        font-size: 16px;
        margin-bottom: 32px;
    }
    .form-benefits {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }
    .form-benefits li {
        color: #c8d4e0;
        font-size: 15px;
        padding-left: 28px;
        position: relative;
    }
    .form-benefits li::before {
        content: "✦";
        position: absolute;
        left: 0;
        color: #3b82f6;
    }
    .form-group { margin-bottom: 20px; }
    .form-group label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #8a9aa8;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    .form-group input,
    .form-group select,
    .form-group textarea {
        width: 100%;
        padding: 14px 18px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 12px;
        color: #fff;
        font-size: 15px;
        font-family: inherit;
        outline: none;
        transition: border-color 0.3s, background 0.3s;
    }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
        border-color: #3b82f6;
        background: rgba(59,130,246,0.05);
    }
    .form-group input::placeholder,
    .form-group textarea::placeholder { color: #4a5a6a; }
    .form-group select option { background: #0a0e14; color: #fff; }
    .form-group textarea { resize: vertical; min-height: 80px; }
    .checkbox-group {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 24px;
        font-size: 13px;
        color: #6a7a8a;
        line-height: 1.6;
    }
    .checkbox-group input {
        margin-top: 3px;
        width: 18px; height: 18px;
        accent-color: #3b82f6;
        flex-shrink: 0;
        cursor: pointer;
    }
    .checkbox-group a { color: #3b82f6; }

    .form-status {
        margin-top: 16px;
        padding: 14px 18px;
        border-radius: 12px;
        font-size: 14px;
        text-align: center;
        display: none;
    }
    .form-status.success {
        display: block;
        background: rgba(34,197,94,0.1);
        border: 1px solid rgba(34,197,94,0.3);
        color: #22c55e;
    }
    .form-status.error {
        display: block;
        background: rgba(239,68,68,0.1);
        border: 1px solid rgba(239,68,68,0.3);
        color: #ef4444;
    }

    @media (max-width: 1024px) {
        .form-wrap { grid-template-columns: 1fr; gap: 40px; padding: 40px 28px; }
    }
    @media (max-width: 640px) {
        .form-wrap { padding: 28px 20px; }
    }
</style>

<script>
    // ⚠️ ЗАМЕНИ НА СВОИ ЗНАЧЕНИЯ
    const TELEGRAM_BOT_TOKEN = '8605046991:AAEEqaG2eSSGHLpSlwZE1H6XhI9iMwtjsFw';
    const TELEGRAM_CHAT_ID = '5556097318';

    const form = document.getElementById('contactForm') as HTMLFormElement | null;

    if (form) {
        // Статус-блок
        const status = document.createElement('div');
        status.className = 'form-status';
        form.appendChild(status);

        form.addEventListener('submit', async (e) => {
            e.preventDefault();

            const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
            const originalText = btn.innerHTML;

            // Собираем данные
            const formData = new FormData(form);
            const name = formData.get('name')?.toString().trim() || '—';
            const contact = formData.get('contact')?.toString().trim() || '—';
            const service = formData.get('service')?.toString().trim() || '—';
            const message = formData.get('message')?.toString().trim() || '—';

            // Валидация
            if (!name || !contact) {
                status.className = 'form-status error';
                status.textContent = 'Заполни имя и контакт';
                return;
            }

            const consent = formData.get('consent');
            if (!consent) {
                status.className = 'form-status error';
                status.textContent = 'Нужно согласие на обработку данных';
                return;
            }

            // Блокировка кнопки
            btn.disabled = true;
            btn.innerHTML = 'Отправка...';
            status.className = 'form-status';

            // Формируем сообщение для Telegram (HTML-разметка)
            const escapeHtml = (s: string) =>
                s.replace(/&/g, '&amp;')
                 .replace(/</g, '&lt;')
                 .replace(/>/g, '&gt;');

            const text = [
                '🔔 <b>Новая заявка с сайта</b>',
                '',
                `<b>Имя:</b> ${escapeHtml(name)}`,
                `<b>Контакт:</b> ${escapeHtml(contact)}`,
                `<b>Услуга:</b> ${escapeHtml(service)}`,
                `<b>Комментарий:</b> ${escapeHtml(message)}`,
                '',
                `🕐 ${new Date().toLocaleString('ru-RU')}`
            ].join('\n');

            try {
                const response = await fetch(
                    `https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage`,
                    {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            chat_id: TELEGRAM_CHAT_ID,
                            text: text,
                            parse_mode: 'HTML',
                            disable_web_page_preview: true
                        })
                    }
                );

                const data = await response.json();

                if (data.ok) {
                    status.className = 'form-status success';
                    status.textContent = '✓ Заявка отправлена! Отвечу в течение часа.';
                    form.reset();
                } else {
                    throw new Error(data.description || 'Ошибка отправки');
                }
            } catch (err) {
                console.error(err);
                status.className = 'form-status error';
                status.textContent = 'Ошибка отправки. Напиши напрямую в Telegram.';
            } finally {
                btn.innerHTML = originalText;
                btn.disabled = false;
                setTimeout(() => {
                    status.className = 'form-status';
                }, 8000);
            }
        });
    }
</script>