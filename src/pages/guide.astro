        const menuList = document.getElementById('menuList') as HTMLElement;
        const guideContent = document.getElementById('guideContent') as HTMLElement;

        function renderMenu(activeId: string) {
            if (!menuList) return;
            menuList.innerHTML = blocks.map(b => `
                <button class="menu-item ${b.id === activeId ? 'active' : ''}" data-id="${b.id}">
                    <span class="menu-icon">${b.icon}</span>
                    <span class="menu-text">
                        <span class="menu-title-text">${b.title}</span>
                        <span class="menu-cat cat-${b.category}">${b.categoryLabel}</span>
                    </span>
                </button>
            `).join('');

            menuList.querySelectorAll('.menu-item').forEach(btn => {
                btn.addEventListener('click', () => {
                    const id = (btn as HTMLElement).dataset.id || '';
                    renderBlock(id);
                    renderMenu(id);
                    history.replaceState(null, '', '#' + id);
                });
            });
        }

        function renderBlock(id: string) {
            if (!guideContent) return;
            const block = blocks.find(b => b.id === id);
            if (!block) return;

            const relatedBlocks = block.related
                .map(rid => blocks.find(b => b.id === rid))
                .filter(Boolean) as BlockData[];

            guideContent.innerHTML = `
                <div class="block-content">
                    <div class="block-header">
                        <div class="block-icon">${block.icon}</div>
                        <div class="block-titles">
                            <h2>${block.title}</h2>
                            <p>${block.subtitle}</p>
                        </div>
                        <div class="block-cat cat-${block.category}">${block.categoryLabel}</div>
                    </div>

                    <div class="block-analogy">${block.analogy}</div>

                    <div class="block-section">
                        <div class="block-section-title">Что это</div>
                        <p class="block-text">${block.what}</p>
                    </div>

                    <div class="block-section">
                        <div class="block-section-title">Пример для наставницы</div>
                        <div class="ls-demo">${block.example}</div>
                    </div>

                    <div class="block-section">
                        <div class="block-section-title">Зачем нужен</div>
                        <ul class="block-why">
                            ${block.why.map(w => `<li>${w}</li>`).join('')}
                        </ul>
                    </div>

                    <div class="block-meta">
                        <div class="meta-item">
                            <div class="meta-label">Кому подходит</div>
                            <div class="meta-tags">
                                ${block.who.map(w => `<span class="meta-tag">${w}</span>`).join('')}
                            </div>
                        </div>
                        <div class="meta-item">
                            <div class="meta-label">Сложность</div>
                            <div class="meta-value">${block.complexity}</div>
                        </div>
                    </div>

                    ${relatedBlocks.length > 0 ? `
                        <div class="block-section">
                            <div class="block-section-title">Обычно заказывают вместе</div>
                            <div class="related-list">
                                ${relatedBlocks.map(r => `
                                    <button class="related-item" data-id="${r.id}">
                                        <span>${r.icon}</span> ${r.title}
                                    </button>
                                `).join('')}
                            </div>
                        </div>
                    ` : ''}
                </div>
            `;

            guideContent.querySelectorAll('.related-item').forEach(btn => {
                btn.addEventListener('click', () => {
                    const rid = (btn as HTMLElement).dataset.id || '';
                    renderBlock(rid);
                    renderMenu(rid);
                    history.replaceState(null, '', '#' + rid);
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            });
        }

        const hash = window.location.hash.replace('#', '');
        const initialId = blocks.find(b => b.id === hash) ? hash : 'hero';
        renderMenu(initialId);
        renderBlock(initialId);
