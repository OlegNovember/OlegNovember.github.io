---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FixedCta from '../components/FixedCta.astro';
---

<Base title="Гид по блокам лендинга — Олег Громов">
    <Header />

    <section class="guide-hero">
        <div class="container">
            <div class="guide-top-actions">
                <a href="/" class="back-link">← На главную</a>
                <a href="/#constructor" class="back-link">← Вернуться к конструктору</a>
            </div>
            <div class="section-label">Гид по блокам</div>
            <h1 class="guide-title">Что должно быть <em>на твоём сайте</em></h1>
            <p class="guide-sub">
                Разбираю 12 блоков, из которых собирается лендинг. Что это, зачем, кому подходит — на примере наставницы Ларисы Морозовой.
            </p>
            
        </div>
    </section>

    <section class="guide-section">
        <div class="container">
            <div class="guide-layout">
                <aside class="guide-menu" id="guideMenu">
    <div class="menu-title">Блоки</div>
    <div class="menu-list" id="menuList"></div>
    <a href="/larisa" target="_blank" class="btn-preview-larisa">
        <span>Посмотреть сайт Ларисы целиком</span>
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
</aside>
                <div class="guide-content" id="guideContent"></div>
            </div>
        </div>
    </section>

    <Footer />
    <FixedCta />

    <script>
        type BlockData = {
            id: string;
            icon: string;
            title: string;
            subtitle: string;
            category: 'base' | 'expert' | 'visual';
            categoryLabel: string;
            analogy: string;
            what: string;
            example: string;
            why: string[];
            who: string[];
            complexity: string;
            related: string[];
        };

        const blocks: BlockData[] = [
            {
                id: 'hero',
                icon: '🎯',
                title: 'Hero',
                subtitle: 'Первый экран',
                category: 'base',
                categoryLabel: 'База',
                analogy: 'Обложка книги. Если не зацепит — дальше не читают.',
                what: 'Первое, что видит человек, когда заходит на сайт. Здесь — твоё имя, суть и кнопка действия.',
                example: `
    <div class="ls-hero">
        <div class="ls-hero-content">
            <div class="ls-badge">Наставница для женщин 45+</div>
            <h3>Лариса <em>Морозова</em></h3>
            <p>Начала своё дело в 51. Помогаю женщинам 45+ сделать то же самое — без кредитов и страха.</p>
            <button class="ls-btn">Записаться на разбор</button>
        </div>
        <div class="ls-hero-photo">
            <img src="/images/larisa/larisa-hero.jpg" alt="Лариса Морозова" onerror="this.style.display='none'" />
            <span class="ls-hero-photo-fallback">👤</span>
        </div>
    </div>
`,
                why: [
                    'За 3 секунды объясняет, кто ты и чем полезна',
                    'Сразу даёт действие — «записаться», «написать»',
                    'Отсеивает тех, кому не подходит',
                    'Создаёт первое впечатление о тебе'
                ],
                who: ['Психологам', 'Коучам', 'Наставницам', 'Мастерам'],
                complexity: 'Базовая',
                related: ['about', 'reviews', 'form']
            },
            {
                id: 'about',
                icon: '👤',
                title: 'О себе',
                subtitle: 'Знакомство',
                category: 'base',
                categoryLabel: 'База',
                analogy: 'Знакомство. Прежде чем работать — люди хотят понять, кто ты.',
                what: 'Блок, где ты рассказываешь о себе. Не резюме, а история. Опыт, путь, принципы.',
                example: `
                    <div class="ls-about">
                        <div class="ls-section-label">Обо мне</div>
                        <h3>Меня зовут Лариса</h3>
                        <p>25 лет работала по найму — бухгалтером, потом администратором в салоне красоты. В 51 стала бабушкой и поняла: хочу не дожить до пенсии, а сделать что-то своё.</p>
                        <p>Три года назад запустила первый онлайн-проект. Сейчас помогаю женщинам 45+ начать свой путь быстрее и без страха.</p>
                    </div>
                `,
                why: [
                    'Закрывает вопрос «а кто ты вообще?»',
                    'Показывает человеческое лицо',
                    'Отстраивает от конкурентов через историю',
                    'Создаёт эмоциональную связь'
                ],
                who: ['Экспертам', 'Коучам', 'Психологам', 'Наставницам'],
                complexity: 'Базовая',
                related: ['hero', 'reviews', 'program']
            },
            {
                id: 'reviews',
                icon: '💬',
                title: 'Отзывы',
                subtitle: 'Социальное доказательство',
                category: 'base',
                categoryLabel: 'База',
                analogy: 'Сарафанное радио в цифровом виде.',
                what: 'Блок, где твои ученицы рассказывают о результате. С фото, именем, возрастом, городом.',
                example: `
                    <div class="ls-reviews">
                        <div class="ls-section-label">Отзывы</div>
                        <div class="ls-review">
                            <p>«Лариса, спасибо. Думала, в 53 поздно начинать. А теперь у меня своя кондитерская».</p>
                            <div class="ls-review-author">— Наталья, 53 года, Ярославль</div>
                        </div>
                        <div class="ls-review">
                            <p>«Начала после выхода на пенсию. Думала, всё — жизнь закончилась. А оказалось, только началась».</p>
                            <div class="ls-review-author">— Ольга, 58 лет, Краснодар</div>
                        </div>
                    </div>
                `,
                why: [
                    'Снимает страх «а вдруг не получится»',
                    'Показывает реальные результаты',
                    'Отвечает на возражения',
                    'Создаёт доверие к тебе'
                ],
                who: ['Всем, у кого есть клиенты'],
                complexity: 'Базовая',
                related: ['hero', 'cases', 'form']
            },
            {
                id: 'form',
                icon: '📩',
                title: 'Форма заявки',
                subtitle: 'Точка контакта',
                category: 'base',
                categoryLabel: 'База',
                analogy: 'Дверь в твой кабинет.',
                what: 'Блок, где клиент оставляет контакты. Простая форма: имя + телефон/Telegram + кнопка.',
                example: `
                    <div class="ls-form">
                        <div class="ls-section-label">Оставить заявку</div>
                        <div class="ls-field">Имя</div>
                        <div class="ls-field">Telegram или телефон</div>
                        <button class="ls-btn">Записаться на разбор</button>
                    </div>
